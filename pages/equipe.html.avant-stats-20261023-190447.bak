  <main class="subpage section-shell">
    <p class="eyebrow">01 / identité</p>
    <h1 class="page-title">Notre<br><em>équipe.</em></h1>
    <p class="page-intro">
      Six joueurs, une seule équipe. Découvrez les membres
      de Suicide Crew sur Honor of Kings.
    </p>

    <div class="player-grid subpage-grid">

      <article class="player-card">
        <div class="player-portrait portrait-one">
          <span>O</span>
        </div>
        <div class="player-info">
          <span class="role">POLYVALENT</span>
          <h3>Oli╰‿╯</h3>
          <p>Prêt à s'adapter à l'équipe.</p>
        </div>
        <span class="card-index">01</span>
      </article>

      <article class="player-card">
        <div class="player-portrait portrait-two">
          <span>TZ</span>
        </div>
        <div class="player-info">
          <span class="role">JUNGLE · ADC</span>
          <h3>TZENITH╰‿╯</h3>
          <p>Jungle et ligne de tireur.</p>
        </div>
        <span class="card-index">02</span>
      </article>

      <article class="player-card">
        <div class="player-portrait portrait-three">
          <span>OG</span>
        </div>
        <div class="player-info">
          <span class="role">MID · SUPPORT</span>
          <h3>Overgamer╰‿╯</h3>
          <p>Milieu et soutien de l'équipe.</p>

        <span class="card-index">03</span>
      </article>

      <article class="player-card">
        <div class="player-portrait portrait-four">
          <span>Y</span>
        </div>
        <div class="player-info">
          <span class="role">SUPPORT · MID</span>
          <h3>Yuna╰‿╯</h3>

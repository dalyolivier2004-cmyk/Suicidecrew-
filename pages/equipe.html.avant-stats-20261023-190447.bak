        </div>
        <span class="card-index">04</span>
      </article>

      <article class="player-card">
        <div class="player-portrait portrait-five">
          <span>UM</span>
        </div>
        <div class="player-info">
          <span class="role">TOP · JUNGLE · SUPPORT</span>
          <h3>Urek Mazino╰‿╯</h3>
          <p>Polyvalent sur trois rôles.</p>
